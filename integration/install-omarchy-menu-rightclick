#!/bin/bash
#
# Adds "right-click an app to pin/unpin it on the dock" to the Omarchy menu
# (Super+Space).
#
# The menu is a first-party Quickshell plugin under /usr/share/omarchy, which
# `omarchy update` overwrites, so the change goes into a clone under
# ~/.config/omarchy/plugins/ instead. The clone's manifest records
# clonedFrom: omarchy.menu, so `omarchy menu ...` and Super+Space keep routing
# to it.
#
# Re-run this after an `omarchy update` that changes the menu, to re-apply the
# patch on top of a fresh clone. To go back to the stock menu:
#
#     omarchy plugin remove "$USER.menu"

set -euo pipefail

PATCH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/omarchy-menu-rightclick.patch"
CLONE_ID="${USER:-$(id -un)}.menu"
CLONE_DIR="$HOME/.config/omarchy/plugins/$CLONE_ID"

die() { echo "install-omarchy-menu-rightclick: $*" >&2; exit 1; }

command -v omarchy-plugin-clone >/dev/null || die "Omarchy not found on this system"
[[ -f $PATCH ]] || die "missing patch: $PATCH"

if [[ ! -d $CLONE_DIR ]]; then
  echo "Cloning omarchy.menu -> $CLONE_ID"
  omarchy plugin clone omarchy.menu
fi

[[ -f "$CLONE_DIR/Menu.qml" ]] || die "$CLONE_DIR/Menu.qml not found"

if patch --dry-run --silent -p0 -d "$CLONE_DIR" -i "$PATCH" >/dev/null 2>&1; then
  patch -p0 -d "$CLONE_DIR" -i "$PATCH"
  echo "Patched $CLONE_DIR/Menu.qml"
elif patch -R --dry-run --silent -p0 -d "$CLONE_DIR" -i "$PATCH" >/dev/null 2>&1; then
  echo "Already patched, nothing to do."
else
  die "patch does not apply cleanly to $CLONE_DIR/Menu.qml.
Upstream's menu has changed. Re-apply this by hand: give the row MouseArea
(search for 'id: mouseArea') acceptedButtons of LeftButton|RightButton and
route a right-click on a row with kind === \"app\" to
  Quickshell.execDetached([\"quickshelldock-pin\", \"--toggle\", String(row.appId)])"
fi

omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
echo "Done. Right-click an app in the Super+Space menu to pin or unpin it."
